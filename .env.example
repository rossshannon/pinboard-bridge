# Server Configuration
PORT=1337
NODE_ENV=production

# CORS Configuration (optional)
# Comma-separated list of allowed origins. Leave empty to allow all origins.
# Example: ALLOWED_ORIGINS=https://example.com,https://app.example.com
ALLOWED_ORIGINS=https://rossshannon.github.io

# Rate limits (optional; positive integers)
# Requests per source IP per 15 minutes on /v1/*
# IP_RATE_LIMIT_MAX=300
# /posts/suggest-with-preview requests per token per minute
# PREVIEW_RATE_LIMIT_MAX=20
