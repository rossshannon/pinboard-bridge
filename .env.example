# Server Configuration
PORT=1337
NODE_ENV=production

# CORS Configuration (optional)
# Comma-separated list of allowed origins. Leave empty to allow all origins.
# Example: ALLOWED_ORIGINS=https://example.com,https://app.example.com
ALLOWED_ORIGINS=https://rossshannon.github.com

# Rate limits (optional; whole numbers only)
# IP_RATE_LIMIT_MAX=300            # /v1/* requests per IP per 15 minutes
# PREVIEW_RATE_LIMIT_MAX=20        # /posts/suggest-with-preview requests per IP per minute
# PAGE_PREVIEW_RATE_LIMIT_MAX=60   # /preview requests per IP per minute

# Pinboard call pacing (optional)
# PINBOARD_MIN_INTERVAL_MS=3000    # gap between one user's Pinboard calls; 0 turns spacing off
# PINBOARD_MAX_QUEUE_MS=9000       # longest a call waits for its slot before going straight through
# PINBOARD_TOTAL_BUDGET_MS=25000   # longest a Pinboard call may take, queueing included
